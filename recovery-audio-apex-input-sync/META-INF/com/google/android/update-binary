#!/sbin/sh
# SPDX-License-Identifier: Apache-2.0

OUTFD="$2"
ZIPFILE="$3"
WORKDIR=/tmp/audio-apex-input-sync
APEX_NAME=com.android.hardware.audio.rpi.apex
EXPECTED_APEX_SHA256=1781c9c08197fdcc789350c71c759b9cdfe085683a93dad206037375908af0ff
STOCK_APEX_SHA256=ccf26258c38acdb741566023eefff0a2f288d807f69439904f08ac319b831f9a
LEGACY_RC_SHA256=54beffd16727beca0bd753e95124e8aa25ec48a3b4e4af61922ca34fa2d04ae3
EXPECTED_RC_SHA256=14173fd9cd4628b6c523fb49f08b46af4b133dde690e04163faa6792df4ef629

ui_print() {
    echo "ui_print $1" > /proc/self/fd/$OUTFD
    echo "ui_print" > /proc/self/fd/$OUTFD
}

abort_install() {
    ui_print "ERREUR: $1"
    exit 1
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
    elif command -v busybox >/dev/null 2>&1; then
        busybox sha256sum "$1" | cut -d ' ' -f 1
    elif command -v toybox >/dev/null 2>&1; then
        toybox sha256sum "$1" | cut -d ' ' -f 1
    else
        return 1
    fi
}

ui_print "Raspberry Pi 5 - correctif entree audio ALSA synchrone"

mount /vendor 2>/dev/null || true
mount -o rw,remount /vendor 2>/dev/null || true
if [ ! -d /vendor/apex ]; then
    abort_install "partition /vendor non montee"
fi

CURRENT_APEX=/vendor/apex/$APEX_NAME
if [ ! -s "$CURRENT_APEX" ]; then
    abort_install "APEX audio actuel absent"
fi

current_sha256=$(sha256_file "$CURRENT_APEX") || \
    abort_install "outil SHA-256 indisponible"
case "$current_sha256" in
    "$STOCK_APEX_SHA256"|"$EXPECTED_APEX_SHA256") ;;
    *) abort_install "APEX actuel inconnu; restauration ou build adapte requis" ;;
esac

rm -rf "$WORKDIR"
mkdir -p "$WORKDIR" || abort_install "creation du dossier temporaire"
unzip -p "$ZIPFILE" "vendor/apex/$APEX_NAME" > "$WORKDIR/$APEX_NAME" || \
    abort_install "extraction de l'APEX"
unzip -p "$ZIPFILE" "vendor/etc/init/usb-mic-runtime.rc" > \
    "$WORKDIR/usb-mic-runtime.rc" || abort_install "extraction du fichier init"

apex_sha256=$(sha256_file "$WORKDIR/$APEX_NAME") || \
    abort_install "calcul SHA-256 de l'APEX"
[ "$apex_sha256" = "$EXPECTED_APEX_SHA256" ] || \
    abort_install "empreinte SHA-256 de l'APEX incorrecte"

rc_sha256=$(sha256_file "$WORKDIR/usb-mic-runtime.rc") || \
    abort_install "calcul SHA-256 du fichier init"
[ "$rc_sha256" = "$EXPECTED_RC_SHA256" ] || \
    abort_install "empreinte SHA-256 du fichier init incorrecte"

RC_TARGET=/vendor/etc/init/usb-mic-runtime.rc
install_rc=false
if [ -e "$RC_TARGET" ]; then
    current_rc_sha256=$(sha256_file "$RC_TARGET") || \
        abort_install "calcul SHA-256 du fichier init actuel"
    case "$current_rc_sha256" in
        "$LEGACY_RC_SHA256"|"$EXPECTED_RC_SHA256") install_rc=true ;;
        *) abort_install "usb-mic-runtime.rc actuel inconnu" ;;
    esac
fi

cp -f "$WORKDIR/$APEX_NAME" "$CURRENT_APEX" || \
    abort_install "copie de l'APEX patche"
chown 0:0 "$CURRENT_APEX"
chmod 0644 "$CURRENT_APEX"
restorecon "$CURRENT_APEX" 2>/dev/null || \
    chcon u:object_r:vendor_file:s0 "$CURRENT_APEX" 2>/dev/null || true

if [ "$install_rc" = true ]; then
    cp -f "$WORKDIR/usb-mic-runtime.rc" "$RC_TARGET" || \
        abort_install "mise a jour du fichier init"
    chown 0:0 "$RC_TARGET"
    chmod 0644 "$RC_TARGET"
    restorecon "$RC_TARGET" 2>/dev/null || \
        chcon u:object_r:vendor_configs_file:s0 "$RC_TARGET" 2>/dev/null || true
fi

installed_sha256=$(sha256_file "$CURRENT_APEX") || \
    abort_install "verification finale de l'APEX"
[ "$installed_sha256" = "$EXPECTED_APEX_SHA256" ] || \
    abort_install "verification finale de l'APEX incorrecte"

sync
ui_print "APEX audio patche installe et verifie."
if [ "$install_rc" = true ]; then
    ui_print "Ancien reglage de periode 20 ms retire."
fi
ui_print "Redemarrez maintenant vers System."
exit 0
