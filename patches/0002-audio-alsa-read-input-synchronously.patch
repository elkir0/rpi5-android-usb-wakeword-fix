From: elkir0 <92492922+elkir0@users.noreply.github.com>
License: Apache-2.0
Subject: [PATCH] audio: alsa: read input synchronously

The Android 16 ALSA stream uses a non-blocking MonoPipe between a background
ALSA reader and AudioFlinger.  With the 5 ms (240 frame) input used by the
hotword capture path, AudioFlinger frequently wins the race and StreamAlsa
replaces the missing samples with silence.

Backport the input architecture used by Raspberry Vanilla Android 17: read
ALSA synchronously from transfer().  Preserve the Android 16 asynchronous
MonoPipe implementation for output to keep this change narrowly scoped.

---
 audio/alsa/StreamAlsa.cpp | 57 +++++++++++++++++++++++----------------
 1 file changed, 34 insertions(+), 23 deletions(-)

diff --git a/audio/alsa/StreamAlsa.cpp b/audio/alsa/StreamAlsa.cpp
index 7a44cc7..bd720fe 100644
--- a/audio/alsa/StreamAlsa.cpp
+++ b/audio/alsa/StreamAlsa.cpp
@@ -128,16 +128,22 @@ StreamAlsa::~StreamAlsa() {
             return ::android::NO_INIT;
         }
         alsaDeviceProxies.push_back(std::move(proxy));
-        auto sink = makeSink(mIsInput);  // Do not block the writer when it is on our thread.
-        if (sink != nullptr) {
-            sinks.push_back(sink);
-        } else {
-            return ::android::NO_INIT;
-        }
-        if (auto source = makeSource(sink.get()); source != nullptr) {
-            sources.push_back(source);
-        } else {
-            return ::android::NO_INIT;
+        // Input must be read synchronously in transfer().  With a non-blocking MonoPipe,
+        // AudioFlinger often consumes a 5 ms block before the ALSA reader thread has filled it
+        // and the old path replaces the complete block with silence.  Android 17 removed this
+        // pipe for the same reason.  Keep the existing asynchronous path for output only.
+        if (!mIsInput) {
+            auto sink = makeSink(false /*writeCanBlock*/);
+            if (sink != nullptr) {
+                sinks.push_back(sink);
+            } else {
+                return ::android::NO_INIT;
+            }
+            if (auto source = makeSource(sink.get()); source != nullptr) {
+                sources.push_back(source);
+            } else {
+                return ::android::NO_INIT;
+            }
         }
     }
     if (alsaDeviceProxies.empty()) {
@@ -146,10 +152,11 @@ StreamAlsa::~StreamAlsa() {
     mAlsaDeviceProxies = std::move(alsaDeviceProxies);
     mSources = std::move(sources);
     mSinks = std::move(sinks);
-    mIoThreadIsRunning = true;
-    for (size_t i = 0; i < mAlsaDeviceProxies.size(); ++i) {
-        mIoThreads.emplace_back(mIsInput ? &StreamAlsa::inputIoThread : &StreamAlsa::outputIoThread,
-                                this, i);
+    if (!mIsInput) {
+        mIoThreadIsRunning = true;
+        for (size_t i = 0; i < mAlsaDeviceProxies.size(); ++i) {
+            mIoThreads.emplace_back(&StreamAlsa::outputIoThread, this, i);
+        }
     }
     return ::android::OK;
 }
@@ -163,18 +170,15 @@ StreamAlsa::~StreamAlsa() {
     const size_t bytesToTransfer = frameCount * mFrameSizeBytes;
     unsigned maxLatency = 0;
     if (mIsInput) {
-        const size_t i = 0;  // For the input case, only support a single device.
-        LOG(VERBOSE) << __func__ << ": reading from sink " << i;
-        ssize_t framesRead = mSources[i]->read(buffer, frameCount);
-        LOG_IF(FATAL, framesRead < 0) << "Error reading from the pipe: " << framesRead;
-        if (ssize_t framesMissing = static_cast<ssize_t>(frameCount) - framesRead;
-            framesMissing > 0) {
-            LOG(WARNING) << __func__ << ": incomplete data received, inserting " << framesMissing
-                         << " frames of silence";
-            memset(static_cast<char*>(buffer) + framesRead * mFrameSizeBytes, 0,
-                   framesMissing * mFrameSizeBytes);
+        // For input only a single device is supported.  Read it on the transfer thread so the
+        // caller receives real samples instead of racing a non-blocking MonoPipe reader.
+        if (int ret = proxy_read_with_retries(mAlsaDeviceProxies[0].get(), buffer, bytesToTransfer,
+                                              mReadWriteRetries);
+            ret != 0) {
+            LOG(WARNING) << __func__ << ": read failed: " << ret;
+            return ::android::INVALID_OPERATION;
         }
-        maxLatency = proxy_get_latency(mAlsaDeviceProxies[i].get());
+        maxLatency = proxy_get_latency(mAlsaDeviceProxies[0].get());
     } else {
         alsa::applyGain(buffer, mGain, bytesToTransfer, mConfig.value().format, mConfig->channels);
         for (size_t i = 0; i < mAlsaDeviceProxies.size(); ++i) {
