#!/sbin/sh
# SPDX-License-Identifier: Apache-2.0

OUTFD="$2"

ui_print() {
    echo "ui_print $1" > /proc/self/fd/$OUTFD
    echo "ui_print" > /proc/self/fd/$OUTFD
}

ui_print "Raspberry Pi 5 - retrait du routage micro USB au demarrage"

mount /vendor 2>/dev/null || true
if [ ! -d /vendor/etc/init ] || [ ! -d /vendor/bin ]; then
    ui_print "ERREUR: partition /vendor non montee"
    exit 1
fi

rm -f /vendor/etc/init/usb-mic-runtime.rc
rm -f /vendor/bin/usb-mic-runtime.sh
rm -f /vendor/etc/usb-mic-route.apk
sync

ui_print "Automatisation retiree. Audio Policy inchangee."
ui_print "Redemarrez vers System."
exit 0
